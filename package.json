{
  "name": "@warpfi/react",
  "version": "0.1.0",
  "description": "React components and hooks for the Pay with Warp embedded checkout.",
  "keywords": [
    "warp",
    "pay-with-warp",
    "payments",
    "crypto",
    "checkout",
    "react",
    "embed"
  ],
  "license": "MIT",
  "author": "Warp Labs",
  "homepage": "https://developer.usewarp.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WarpCompany/warp-react.git"
  },
  "bugs": "https://github.com/WarpCompany/warp-react/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@warpfi/js": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
